          "type": [
            "object",
            "null"
          ]
        },
        "mcpServerOpenaiFormElicitation": {
          "type": "boolean"
        },
        "optOutNotificationMethods": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "requestAttestation": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "capabilities": {
      "anyOf": [
        {
          "$ref": "#/definitions/InitializeCapabilities"
        },
        {
          "type": "null"
        }
      ]
    },
    "clientInfo": {
      "$ref": "#/definitions/ClientInfo"
    }
  },
  "required": [
