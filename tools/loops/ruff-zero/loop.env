# Settings of the ruff-zero control loop, read by run.sh and sensor.py. The charter (set point,
# scope, sensor, controller, cadence) is the loop bead's description; these are its values.
# shellcheck shell=bash disable=SC2034

LOOP_NAME="ruff-zero"
# The loop's feature bead. Empty until it exists; a real run refuses without it.
LOOP_BEAD="cr-p3em.7"
# Base branch of every run's branch and pull request: mvp-stack until it merges to main.
BASE="mvp-stack"
REMOTE="origin"
BRANCH_PREFIX="loop/ruff-zero"

# Set point: no Ruff finding in the tracked Python under these roots. Out of scope:
# workflow_interpreter/ (owner answer 3a, its own gate), .claude/skills/ (a change there moves
# a registry tree hash the gate's registry check then refuses), .codex/ (a mirror, synced at
# the end of the overhaul), and submodules (not tracked here).
SCOPE_ROOTS=".claude/scripts .claude/hooks curation harness_lifecycle scripts tests tools"

# The sensor's pin: the rules Ruff enables and its target version, as resolved for this tree
# (no [tool.ruff] or ruff.toml: Ruff's defaults, target version 3.13 from requires-python).
# A different count or sha stops the run for the owner to re-pin.
RULESET_COUNT="413"
RULESET_SHA="9a642dd9f2c4"

# The actuator: a headless agent with an allowlist, a turn limit and an optional spend cap.
AGENT_BIN="claude"
AGENT_MODEL=""
TURN_LIMIT="40"
AGENT_BUDGET_USD=""

GATE=".claude/skills/mvp-mode/playbooks/autopilot-full/commit_gate.py"
