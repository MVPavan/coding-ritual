# Copy to .env and fill in. Load with: set -a; . tools/T3/.env; set +a
T3_HOST_NAME=<windows-host-name>
T3_ENV_ID_WSL=<uuid from ~/.t3/userdata/environment-id>
T3_ENV_ID_WINDOWS=<uuid from the Windows userdata environment-id>
T3_WIN_USERDATA='C:\Users\<user>\.t3\userdata'
T3_WIN_USERDATA_WSL='/mnt/c/Users/<user>/.t3/userdata'
TAILNET_IP=<tailscale IPv4 of this PC>
